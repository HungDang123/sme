# PostgreSQL
POSTGRES_USER=sme
POSTGRES_PASSWORD=sme_secret
POSTGRES_DB=sme_listening
DATABASE_URL=postgres://sme:sme_secret@postgres:5432/sme_listening?sslmode=disable

# Ingest auth (shared between ingest-service and mention-service)
INGEST_TOKEN=change-me-ingest-token

# RapidAPI (Facebook / YouTube crawl)
RAPIDAPI_KEY=
RAPIDAPI_FACEBOOK_HOST=facebook-scraper3.p.rapidapi.com
RAPIDAPI_YOUTUBE_HOST=youtube-v31.p.rapidapi.com

# Gemini sentiment
GEMINI_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
